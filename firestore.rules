rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all (Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: SaleTicket
    function isValidSaleTicket(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.folio is string && data.folio.size() > 0 &&
             data.subtotal is number && data.subtotal >= 0 &&
             data.total is number && data.total >= 0;
    }

    // Validation Blueprint: ShiftCutRecord
    function isValidShiftCut(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.folio is string && data.folio.size() > 0 &&
             data.totalGrossSales is number &&
             data.totalCashSales is number;
    }

    // Validation Blueprint: BakeryOrder
    function isValidOrder(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.folio is string && data.folio.size() > 0 &&
             data.total is number && data.total >= 0;
    }

    // Validation Blueprint: Customer
    function isValidCustomer(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0;
    }

    // Validation Blueprint: CashOutflowItem
    function isValidOutflow(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.concept is string && data.concept.size() > 0 &&
             data.amount is number && data.amount >= 0;
    }

    // Validation Blueprint: DriverDaySettlement
    function isValidDriverSettlement(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.date is string && data.date.size() > 0 && data.date.size() <= 32 &&
             data.driverId in ['osvaldo', 'simon'] &&
             (!('shift' in data) || data.shift in ['madrugada', 'manana', 'tarde']) &&
             data.settled is bool &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Validation Blueprint: VipCustomer
    function isValidVipCustomer(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    // Validation Blueprint: VipOrder
    function isValidVipOrder(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.folio is string && data.folio.size() > 0 && data.folio.size() <= 64 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200 &&
             data.totalAmount is number && data.totalAmount >= 0;
    }

    // Collection: tickets (Registro automático de ventas de panadería - Sin necesidad de login manual)
    match /tickets/{ticketId} {
      allow read: if true;
      allow create, update: if isValidId(ticketId) && isValidSaleTicket(incoming());
      allow delete: if true;
    }

    // Collection: shiftCuts (Cortes de caja y turno automáticos)
    match /shiftCuts/{cutId} {
      allow read: if true;
      allow create, update: if isValidId(cutId) && isValidShiftCut(incoming());
      allow delete: if true;
    }

    // Collection: orders (Pedidos para reparto y mostrador)
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if isValidId(orderId) && isValidOrder(incoming());
      allow delete: if true;
    }

    // Collection: customers (Clientes y puntos de lealtad)
    match /customers/{customerId} {
      allow read: if true;
      allow create, update: if isValidId(customerId) && isValidCustomer(incoming());
      allow delete: if true;
    }

    // Collection: outflows (Salidas de dinero de caja)
    match /outflows/{outflowId} {
      allow read: if true;
      allow create, update: if isValidId(outflowId) && isValidOutflow(incoming());
      allow delete: if true;
    }

    // Collection: dailyDelivery (Carga de piezas y repartos diarios en tiempo real)
    match /dailyDelivery/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId);
      allow delete: if true;
    }

    // Collection: driverCustomers (Lista de clientes y precios para reparto)
    match /driverCustomers/{customerId} {
      allow read: if true;
      allow create, update: if isValidId(customerId);
      allow delete: if true;
    }

    // Collection: operationalExpenses (Control de gastos operativos y nómina)
    match /operationalExpenses/{expenseId} {
      allow read: if true;
      allow create, update: if isValidId(expenseId);
      allow delete: if true;
    }

    // Collection: supplierBills (Cuentas por pagar de proveedores / corte de viernes)
    match /supplierBills/{billId} {
      allow read: if true;
      allow create, update: if isValidId(billId);
      allow delete: if true;
    }

    // Collection: supplierBankProfiles (Datos bancarios de proveedores)
    match /supplierBankProfiles/{profileId} {
      allow read: if true;
      allow create, update: if isValidId(profileId);
      allow delete: if true;
    }

    // Collection: driverSettlements (Estado de liquidación diaria por repartidor)
    match /driverSettlements/{settlementId} {
      allow read: if true;
      allow create, update: if isValidId(settlementId) && isValidDriverSettlement(incoming());
      allow delete: if true;
    }

    // Collection: vip_customers (Clientes VIP para facturación y transferencias)
    match /vip_customers/{customerId} {
      allow read: if true;
      allow create, update: if isValidId(customerId) && isValidVipCustomer(incoming());
      allow delete: if true;
    }

    // Collection: vip_orders (Pedidos de Clientes VIP)
    match /vip_orders/{orderId} {
      allow read: if true;
      allow create, update: if isValidId(orderId) && isValidVipOrder(incoming());
      allow delete: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
